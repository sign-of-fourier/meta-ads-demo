# ── Meta App credentials ────────────────────────────────
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
META_API_VERSION=v19.0

# ── App settings ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-random-string

# ── Ad generation pipeline ───────────────────────────────
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_ANALYSIS_DEPLOYMENT=gpt-4o
AZURE_SCORING_DEPLOYMENT=gpt-4-04-14
AZURE_TEXT_GEN_DEPLOYMENT=gpt-4o
DEAPI_API_KEY=YOUR_DEAPI_API_KEY
# Base URL where generated images are publicly reachable (used by the scorer)
IMAGES_SERVE_BASE_URL=http://localhost:8000/images
