# ── Meta App credentials ────────────────────────────────
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
META_API_VERSION=v19.0

# ── App settings ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-random-string
# Internal-only key for POST /api/admin/users/{id}/tier (sets tier without Stripe).
# Leave blank in prod until you have an actual admin secret; the route 503s when unset.
ADMIN_API_KEY=

# ── Ad generation pipeline ───────────────────────────────
AZURE_OPENAI_KEY=YOUR_AZURE_OPENAI_KEY
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_ANALYSIS_DEPLOYMENT=gpt-4o
AZURE_SCORING_DEPLOYMENT=gpt-4-04-14
AZURE_TEXT_GEN_DEPLOYMENT=gpt-4o
DEAPI_API_KEY=YOUR_DEAPI_API_KEY
# Base URL where generated images are publicly reachable (used by the scorer)
IMAGES_SERVE_BASE_URL=http://localhost:8000/images

# ── Bayesian Optimisation tuning ─────────────────────────
# All optional — defaults shown. See ENV.md §5 for details.
# MODAL_BO_API_URL=                       # leave blank → local sklearn GPR
# MODAL_BO_PCA_DIMS=64                    # PCA components for Meta embeddings
# GOOGLE_BO_PCA_DIMS=32                   # PCA components for Google embeddings
# BO_MIN_REAL_OBS=5                       # real-metric obs needed before Qwen warm-start is dropped
# MIN_CONVERGENCE_IMPRESSIONS=500         # floor impressions before convergence check fires
# MIN_CONVERGENCE_DAYS=3                  # floor days before convergence check fires
# CONVERGENCE_MARGIN_FRACTION=0.20        # CTR margin width (set 0.80 to converge fast in demo)

# ── Fake servers (dev only) ──────────────────────────────
# Case 1 — pre-warmed metrics (ads already have scores, BO runs normally):
#   Start: cd fake_ad_server && uvicorn server:app --port 9000 --reload
# FAKE_META_BASE_URL=http://localhost:9000/meta/v19.0
# FAKE_GOOGLE_BASE_URL=http://localhost:9000/google
#
# Case 2 — cold start (no scores, warm-start calls real Qwen, push clones, get Qwen-derived CTR):
#   Start: cd fake_ad_server && FAST_RAMP=true uvicorn server:app --port 9000 --reload
#   Port 9000 calls real Qwen internally when insights are queried for pushed clones.
# FAKE_META_BASE_URL=http://localhost:9000/meta/v19.0
# FAKE_GOOGLE_BASE_URL=http://localhost:9000/google
